{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build TypeScript",
            "type": "shell",
            "command": "npm run build",
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Watch TypeScript",
            "type": "shell",
            "command": "npm run dev",
            "isBackground": true,
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Serve Your Town",
            "type": "shell",
            "command": "python3 -m http.server 8000",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving.*",
                    "endsPattern": "^.*$"
                }
            }
        }
    ]
}